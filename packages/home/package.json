{
  "name": "@blupinta/home",
  "version": "0.1.0",
  "description": "The Blupinta home format: its TypeScript types and its JSON Schema",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blupinta/blupinta-js.git",
    "directory": "packages/home"
  },
  "homepage": "https://docs.blupinta.app/reference/libraries/",
  "keywords": [
    "blupinta",
    "floor plan",
    "home",
    "json schema"
  ],
  "exports": {
    ".": "./src/generated/home.ts",
    "./schema.json": "./schema/home.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/home.d.ts",
        "default": "./dist/home.js"
      },
      "./schema.json": "./schema/home.schema.json"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  }
}
